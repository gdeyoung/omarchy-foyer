#!/usr/bin/env bash
# Generate foyer.lua (the launcher keybindings) from the keys in
# ~/.config/omarchy/foyer.json, make sure hyprland.lua loads it, and reload
# Hyprland.
#
#   "keys": { "launcher": "SUPER + SPACE", "apps": "SUPER + ALT + SPACE" }
#
# "apps" may be "none". Defaults apply to missing keys. `--remove` undoes it:
# the loader line and the generated file go away; run it before
# `omarchy plugin remove gdeyoung.foyer`, which has no uninstall hook.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BIN_DIR="${OMARUNNER_BIN_DIR:-$HOME/.local/bin}"
CONFIG="${OMARUNNER_CONFIG:-$HOME/.config/omarchy/foyer.json}"
HYPRLAND_LUA="${OMARUNNER_HYPRLAND_LUA:-$HOME/.config/hypr/hyprland.lua}"
OUT="${OMARUNNER_LUA_OUT:-$HERE/foyer.lua}"
LOADER='pcall(dofile, (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/gdeyoung.foyer/foyer.lua")'
MARKER='gdeyoung.foyer/foyer.lua'

command -v jq >/dev/null || { echo "foyer-apply: jq is required" >&2; exit 1; }

reload() {
  if command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprctl reload >/dev/null
    local errors
    errors=$(hyprctl configerrors 2>&1 || true)
    if [[ -n ${errors//[[:space:]]/} ]]; then
      echo "foyer-apply: hyprctl configerrors reported:" >&2
      echo "$errors" >&2
      exit 1
    fi
    echo "foyer-apply: reloaded, config clean"
  fi
}

if [[ ${1:-} == --remove ]]; then
  changed=false
  if [[ -f $HYPRLAND_LUA ]] && grep -qF "$MARKER" "$HYPRLAND_LUA"; then
    changed=true
    cp "$HYPRLAND_LUA" "$HYPRLAND_LUA.bak.$(date +%s)"
    tmp=$(mktemp)
    # The loader line and the comment line above it.
    grep -vF -e "$MARKER" -e '-- foyer keybindings (gdeyoung.foyer)' "$HYPRLAND_LUA" >"$tmp" || true
    mv "$tmp" "$HYPRLAND_LUA"
    echo "foyer-apply: removed the loader from $(basename "$HYPRLAND_LUA") (backed up first)"
  fi
  [[ -f $OUT ]] && changed=true
  rm -f "$OUT"
  # The PATH link that foyer-setup made; a different foyer is left alone.
  if [[ -L $BIN_DIR/foyer && $(readlink "$BIN_DIR/foyer") == "$HERE/bin/foyer" ]]; then
    rm -f "$BIN_DIR/foyer"
    echo "foyer-apply: removed $BIN_DIR/foyer"
  fi
  # Reload Hyprland only if its config actually changed.
  [[ $changed == true ]] && reload
  exit 0
fi

# ---- read keys (with defaults) ----------------------------------------------
config='{}'
[[ -f $CONFIG ]] && config=$(jq -c '.keys // {}' "$CONFIG" 2>/dev/null || echo '{}')
get() {
  jq -r --arg k "$1" --arg d "$2" 'if has($k) and .[$k] != null then .[$k] else $d end' <<<"$config"
}
LAUNCHER=$(get launcher "SUPER + SPACE")
APPS=$(get apps "SUPER + ALT + SPACE")

usable() { [[ -n $1 && $1 =~ ^[A-Za-z0-9_+.\ -]+$ ]]; }
usable "$LAUNCHER" || { echo "foyer-apply: 'launcher' is not a usable key spec: '$LAUNCHER'" >&2; exit 1; }
if [[ $APPS != none && -n $APPS ]]; then
  usable "$APPS" || { echo "foyer-apply: 'apps' is not a usable key spec: '$APPS'" >&2; exit 1; }
  [[ $APPS != "$LAUNCHER" ]] || { echo "foyer-apply: launcher and apps use the same key: '$LAUNCHER'" >&2; exit 1; }
else
  APPS=none
fi

# ---- generate ---------------------------------------------------------------
tmp=$(mktemp)
{
  echo "-- GENERATED by foyer-apply -- do not edit."
  echo "-- Change the keys with foyer-setup (or \"keys\" in foyer.json),"
  echo "-- then re-run foyer-apply."
  echo
  echo 'local OMARUNNER = (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/gdeyoung.foyer/bin/foyer"'
  echo
  echo "-- Unbind first so the key replaces Omarchy's own binding."
  echo "local function bind(keys, description, command)"
  echo "  hl.unbind(keys)"
  echo "  hl.bind(keys, hl.dsp.exec_cmd(command), { description = description })"
  echo "end"
  echo
  echo "bind(\"$LAUNCHER\", \"foyer\", \"'\" .. OMARUNNER .. \"' toggle\")"
  [[ $APPS == none ]] || echo "bind(\"$APPS\", \"foyer apps\", \"'\" .. OMARUNNER .. \"' toggle apps\")"
} >"$tmp"
if command -v luac >/dev/null && ! luac -p "$tmp" 2>/dev/null; then
  echo "foyer-apply: generated Lua failed to parse, keeping the previous file" >&2
  rm -f "$tmp"
  exit 1
fi
mv "$tmp" "$OUT"
echo "foyer-apply: wrote $OUT (launcher: $LAUNCHER, apps: $APPS)"

# ---- make sure hyprland.lua loads it ----------------------------------------
# pcall+dofile, so removing the plugin directory leaves an inert line, not a
# config error.
if [[ -f $HYPRLAND_LUA ]]; then
  if grep -qF "$MARKER" "$HYPRLAND_LUA"; then
    echo "foyer-apply: loader already present in $(basename "$HYPRLAND_LUA")"
  else
    cp "$HYPRLAND_LUA" "$HYPRLAND_LUA.bak.$(date +%s)"
    printf '\n-- foyer keybindings (gdeyoung.foyer). Inert if the plugin is removed.\n%s\n' "$LOADER" >>"$HYPRLAND_LUA"
    echo "foyer-apply: added the loader to $(basename "$HYPRLAND_LUA") (backed up first)"
  fi
else
  echo "foyer-apply: $HYPRLAND_LUA not found; add this line yourself:" >&2
  echo "  $LOADER" >&2
fi

reload
